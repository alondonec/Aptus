ANTHROPIC_API_KEY=
PORT=3001

# En producción: dominio(s) del frontend desplegado, separados por coma si hay
# más de uno (ej. preview + producción de Vercel). Necesario para que CORS
# permita las peticiones del frontend real.
FRONTEND_URL=

# En producción: ruta a un disco persistente (ej. en Render, el mount path del
# disco que configures, como /var/data). Si no se define, usa ./data local.
DATA_DIR=

# Clave secreta que debe enviar Apps Script (header x-api-key) para poder
# sincronizar el estado del paciente desde Google Sheets. Generar un valor
# aleatorio propio (ej. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# y guardarlo también en las Script Properties de Apps Script — nunca en el repo.
SHEETS_SYNC_API_KEY=
